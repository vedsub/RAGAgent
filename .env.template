# Observability Configuration Template
# Copy this to .env and update values as needed

# API Keys (Required)
GROQ_API_KEY=your_groq_api_key_here

# OpenTelemetry Configuration (Optional - for observability)
# Service identification
OTEL_SERVICE_NAME=rag-evaluation
OTEL_SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# OTLP Exporter (for traces and metrics)
# Default: http://localhost:4317 (for local OpenTelemetry Collector)
# For services like Honeycomb, DataDog, etc., use their endpoints
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARN, ERROR

# Observability Feature Flags
ENABLE_TRACING=true
ENABLE_METRICS=true
TRACE_SAMPLE_RATE=1.0  # 0.0 to 1.0, where 1.0 = 100% sampling

# Optional: Additional OpenTelemetry Configuration
# OTEL_EXPORTER_OTLP_HEADERS=authentication=your_token_here
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=my-instance,host.name=my-host

# Example configurations for popular observability backends:

# For Honeycomb:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your-api-key

# For DataDog:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.collector.dd-datadoghq.com
# OTEL_EXPORTER_OTLP_HEADERS dd-api-key=your-api-key

# For Jaeger (local):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317/otlp/v1/traces

# For Grafana Tempo (local):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317